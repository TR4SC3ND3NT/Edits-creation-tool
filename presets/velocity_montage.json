{
  "format": "edits.preset/1",
  "name": "velocity_montage",
  "description": "Montage speed curve (CapCut): fast, slow, fast, slow, fast, in waves. Retimes the layer's keyed motion or a video's playback; a still picture gets a push that follows the curve.",
  "tags": [
    "speed",
    "velocity",
    "time",
    "curve"
  ],
  "variables": {
    "length": {
      "type": "number",
      "default": 2,
      "min": 0.05,
      "max": 64,
      "unit": "beats",
      "doc": "Length of the curve."
    },
    "zoom": {
      "type": "number",
      "default": 1.15,
      "min": 1,
      "max": 3,
      "doc": "For a still picture: how far the push goes."
    }
  },
  "apply": [
    {
      "retime": {
        "length": "=$length * beat",
        "progress": [
          0.0,
          0.2,
          0.325,
          0.375,
          0.5,
          0.7,
          0.825,
          0.875,
          1.0
        ],
        "otherwise": [
          {
            "pulse": {
              "transform": "scale",
              "adjustment": {
                "effect": "transform2d",
                "param": "scale",
                "base": 1
              },
              "keys": [
                {
                  "dt": 0,
                  "v": "=base"
                },
                {
                  "dt": "=$length * 0.125 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.2)"
                },
                {
                  "dt": "=$length * 0.25 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.325)"
                },
                {
                  "dt": "=$length * 0.375 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.375)"
                },
                {
                  "dt": "=$length * 0.5 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.5)"
                },
                {
                  "dt": "=$length * 0.625 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.7)"
                },
                {
                  "dt": "=$length * 0.75 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.825)"
                },
                {
                  "dt": "=$length * 0.875 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 0.875)"
                },
                {
                  "dt": "=$length * 1.0 * beat",
                  "v": "=orig * (1 + ($zoom - 1) * 1.0)"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
