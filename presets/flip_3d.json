{
  "format": "edits.preset/1",
  "name": "flip_3d",
  "description": "The picture flips in around an axis in 3D, from edge-on to facing the camera.",
  "tags": [
    "3d",
    "move",
    "intro",
    "flip"
  ],
  "variables": {
    "axis": {
      "type": "enum",
      "default": "y",
      "options": {
        "x": {
          "ax": 1,
          "ay": 0
        },
        "y": {
          "ax": 0,
          "ay": 1
        }
      },
      "doc": "y turns like a door, x like a hatch."
    },
    "direction": {
      "type": "enum",
      "default": "forward",
      "options": {
        "forward": {
          "dir": 1
        },
        "backward": {
          "dir": -1
        }
      },
      "doc": "Which way it turns."
    },
    "angle": {
      "type": "number",
      "default": 90,
      "min": 0,
      "max": 180,
      "unit": "degrees",
      "doc": "Angle it starts at, degrees."
    },
    "length": {
      "type": "number",
      "default": 0.5,
      "min": 0.05,
      "max": 16,
      "unit": "beats",
      "doc": "How long it takes."
    }
  },
  "apply": [
    {
      "pulse": {
        "transform": "rotation",
        "keys": [
          {
            "dt": 0,
            "v": "=orig + vec($ax, $ay, 0) * $angle * $dir",
            "ease": "quint_out"
          },
          {
            "dt": "=$length * beat",
            "v": "=orig"
          }
        ]
      }
    }
  ]
}
