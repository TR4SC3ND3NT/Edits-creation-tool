{
  "format": "edits.preset/1",
  "name": "swing",
  "description": "The picture swings from side to side as if hung from the top edge, easing in and out of the swing.",
  "tags": [
    "loop",
    "rotate",
    "swing",
    "combo"
  ],
  "variables": {
    "angle": {
      "type": "number",
      "default": 6,
      "min": 0,
      "max": 45,
      "unit": "degrees",
      "doc": "Widest turn each way."
    },
    "period": {
      "type": "number",
      "default": 2,
      "min": 0.25,
      "max": 16,
      "unit": "beats",
      "doc": "Time of one swing there and back."
    },
    "cycles": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 64,
      "doc": "How many swings, the first and the last eased."
    },
    "cover": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "doc": "Zoom in so the frame's corners never show: 1 just enough, 0 not at all."
    }
  },
  "apply": [
    {
      "oscillate": {
        "transform": "rotation",
        "frequency": "=1 / $period",
        "keys": [
          {
            "dt": 0,
            "v": 0,
            "ease": "in_out"
          },
          {
            "dt": "=$period * 0.5 * beat",
            "v": "=vec(0, 0, $angle)"
          },
          {
            "dt": "=($cycles - 0.5) * $period * beat",
            "v": "=vec(0, 0, $angle)",
            "ease": "in_out"
          },
          {
            "dt": "=$cycles * $period * beat",
            "v": 0
          }
        ]
      }
    },
    {
      "oscillate": {
        "transform": "position",
        "frequency": "=1 / $period",
        "keys": [
          {
            "dt": 0,
            "v": 0,
            "ease": "in_out"
          },
          {
            "dt": "=$period * 0.5 * beat",
            "v": "=vec(-0.5 * $angle * 0.01745, 0, 0)"
          },
          {
            "dt": "=($cycles - 0.5) * $period * beat",
            "v": "=vec(-0.5 * $angle * 0.01745, 0, 0)",
            "ease": "in_out"
          },
          {
            "dt": "=$cycles * $period * beat",
            "v": 0
          }
        ]
      }
    },
    {
      "pulse": {
        "transform": "scale",
        "keys": [
          {
            "dt": 0,
            "v": "=base",
            "ease": "in_out"
          },
          {
            "dt": "=$period * 0.5 * beat",
            "v": "=orig * (1 + $cover * (max(aspect, 1 / aspect) * $angle * 0.01745 + 2 * 0.5 * $angle * 0.01745))"
          },
          {
            "dt": "=($cycles - 0.5) * $period * beat",
            "v": "=orig * (1 + $cover * (max(aspect, 1 / aspect) * $angle * 0.01745 + 2 * 0.5 * $angle * 0.01745))",
            "ease": "in_out"
          },
          {
            "dt": "=$cycles * $period * beat",
            "v": "=orig"
          }
        ]
      }
    }
  ]
}
