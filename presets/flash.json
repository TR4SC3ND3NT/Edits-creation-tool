{
  "format": "edits.preset/1",
  "name": "flash",
  "description": "The picture flashes toward a colour (white by default) on the hit and fades back.",
  "tags": [
    "hit",
    "light",
    "accent"
  ],
  "variables": {
    "strength": {
      "type": "number",
      "default": 0.85,
      "min": 0,
      "max": 1,
      "doc": "How far toward the colour at the peak; 1 is a solid frame."
    },
    "decay": {
      "type": "number",
      "default": 0.5,
      "min": 0.05,
      "max": 8,
      "unit": "beats",
      "doc": "Time to fall back to the picture."
    },
    "color": {
      "type": "color",
      "default": [
        1,
        1,
        1
      ],
      "doc": "Colour of the flash (linear RGB, 0..1, or #rrggbb)."
    }
  },
  "apply": [
    {
      "pulse": {
        "effect": "fade",
        "param": "amount",
        "base": 0,
        "params": {
          "color": "$color"
        },
        "keys": [
          {
            "dt": 0,
            "v": "$strength",
            "ease": "out"
          },
          {
            "dt": "=$decay * beat",
            "v": "=orig"
          }
        ]
      }
    }
  ]
}
