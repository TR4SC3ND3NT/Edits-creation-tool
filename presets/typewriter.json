{
  "format": "edits.preset/1",
  "name": "typewriter",
  "description": "The letters of a text layer appear one by one, left to right, as if typed.",
  "tags": ["text", "reveal", "caption"],
  "layer_kind": "text",
  "variables": {
    "duration": {
      "type": "number",
      "default": 2,
      "min": 0.05,
      "max": 64,
      "unit": "beats",
      "doc": "Time to type the whole text."
    },
    "units": {
      "type": "string",
      "default": "characters",
      "doc": "What appears at each step: characters, words or lines."
    }
  },
  "apply": [
    {
      "animator": {
        "name": "typewriter",
        "selector": {
          "kind": "range",
          "units": "$units",
          "smoothness": 0,
          "start": { "keys": [ { "t": "=at", "v": 0 }, { "t": "=at + $duration * beat", "v": 100 } ] }
        },
        "opacity": 0
      }
    }
  ]
}
