{
  "format": "edits.preset/1",
  "name": "speed_lines",
  "description": "Anime speed lines: thin streaks around a clear centre (radial) or rushing across the frame (horizontal), redrawn every frame.",
  "tags": ["shape", "overlay", "anime"],
  "target": "project",
  "variables": {
    "mode": {
      "type": "enum",
      "default": "radial",
      "options": {
        "radial": { "radial": 1 },
        "horizontal": { "radial": 0 }
      },
      "doc": "radial: lines all round, pointing at the centre; horizontal: lines streaming sideways."
    },
    "count": {
      "type": "integer",
      "default": 60,
      "min": 4,
      "max": 400,
      "doc": "How many lines."
    },
    "width": {
      "type": "number",
      "default": 0.35,
      "min": 0.05,
      "max": 5,
      "unit": "% of height",
      "doc": "Thickness of a line."
    },
    "clear": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "unit": "heights",
      "doc": "Radial: radius of the clear middle, where no line reaches."
    },
    "color": {
      "type": "color",
      "default": [1, 1, 1],
      "doc": "Colour of the lines (sRGB, 0..1, or #rrggbb)."
    },
    "opacity": {
      "type": "number",
      "default": 0.85,
      "min": 0,
      "max": 1,
      "doc": "Opacity of the layer."
    },
    "every": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 4,
      "unit": "beats",
      "doc": "How often the lines are redrawn; 0 at every frame."
    },
    "length": {
      "type": "number",
      "default": 4,
      "min": 0.25,
      "max": 256,
      "unit": "beats",
      "doc": "How long the lines show (they stop at the end of the project)."
    },
    "seed": {
      "type": "integer",
      "default": 1,
      "doc": "Another number gives other lines."
    }
  },
  "apply": [
    {
      "layer": {
        "place": "top",
        "layer": {
          "id": "speed_lines",
          "kind": "shape",
          "in": "=at",
          "out": "=min(end, at + $length * beat)",
          "transform": { "opacity": "$opacity" },
          "shapes": [
            {
              "type": "line",
              "from": ["=$radial * $clear + (1 - $radial) * (0 - aspect * 0.3)", 0],
              "to": ["=$radial * (aspect + 0.6) + (1 - $radial) * aspect * 0.3", 0],
              "stroke": { "color": "$color", "width": "$width", "cap": "round" },
              "operators": [
                {
                  "kind": "repeater",
                  "copies": "$count",
                  "offset": "=(1 - $radial) * (0 - ($count - 1) / 2)",
                  "position": [0, "=(1 - $radial) * 1.1 / $count"],
                  "rotation": "=$radial * 360 / $count",
                  "jitter": {
                    "position": ["=(1 - $radial) * aspect * 0.7", "=(1 - $radial) * 0.5 / $count"],
                    "rotation": "=$radial * 180 / $count",
                    "scale": "=0.2 + (1 - $radial) * 0.4",
                    "opacity": 0.7,
                    "every": "=$every * beat",
                    "seed": "$seed"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
