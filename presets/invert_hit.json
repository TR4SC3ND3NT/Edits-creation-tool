{
  "format": "edits.preset/1",
  "name": "invert_hit",
  "description": "A colour-negative flicker on the hit.",
  "tags": [
    "hit",
    "colour",
    "glitch",
    "accent"
  ],
  "variables": {
    "amount": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "doc": "How inverted (1 = a full negative)."
    },
    "length": {
      "type": "number",
      "default": 0.25,
      "min": 0.05,
      "max": 16,
      "unit": "beats",
      "doc": "How long it stays inverted."
    }
  },
  "apply": [
    {
      "pulse": {
        "effect": "invert",
        "param": "amount",
        "base": 0,
        "keys": [
          {
            "dt": 0,
            "v": "$amount",
            "ease": "hold"
          },
          {
            "dt": "=$length * beat",
            "v": "=orig"
          }
        ]
      }
    }
  ]
}
