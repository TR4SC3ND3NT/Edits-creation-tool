{
  "format": "edits.preset/1",
  "name": "slide_out",
  "description": "The picture accelerates out of frame.",
  "tags": [
    "move",
    "outro",
    "slide"
  ],
  "variables": {
    "direction": {
      "type": "enum",
      "default": "to_left",
      "options": {
        "to_left": {
          "dx": -1,
          "dy": 0
        },
        "to_right": {
          "dx": 1,
          "dy": 0
        },
        "to_top": {
          "dx": 0,
          "dy": -1
        },
        "to_bottom": {
          "dx": 0,
          "dy": 1
        }
      },
      "doc": "Where it goes."
    },
    "distance": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 4,
      "doc": "How far it travels, in frame widths (sideways) or heights (up and down)."
    },
    "length": {
      "type": "number",
      "default": 0.5,
      "min": 0.05,
      "max": 16,
      "unit": "beats",
      "doc": "How long it takes."
    }
  },
  "apply": [
    {
      "pulse": {
        "transform": "position",
        "keys": [
          {
            "dt": 0,
            "v": "=orig",
            "ease": "expo_in"
          },
          {
            "dt": "=$length * beat",
            "v": "=orig + vec($dx * aspect, $dy, 0) * $distance"
          }
        ]
      }
    }
  ]
}
