{
  "format": "edits.preset/1",
  "name": "beat_burst",
  "description": "A burst of sparks flying out from a point on the beat, slowing and falling as they fade.",
  "tags": [
    "particles",
    "hit",
    "glow"
  ],
  "target": "project",
  "variables": {
    "count": {
      "type": "integer",
      "default": 60,
      "min": 1,
      "max": 2000,
      "doc": "How many sparks."
    },
    "position": {
      "type": "vector",
      "default": [0, 0],
      "doc": "Where the burst comes from, in frame heights from the centre (y down)."
    },
    "speed": {
      "type": "number",
      "default": 1.2,
      "min": 0.05,
      "max": 5,
      "unit": "heights per second",
      "doc": "How fast the sparks fly out."
    },
    "color": {
      "type": "color",
      "default": [1, 0.75, 0.35],
      "doc": "Spark colour (linear RGB)."
    },
    "length": {
      "type": "number",
      "default": 2,
      "min": 0.25,
      "max": 16,
      "unit": "beats",
      "doc": "How long the sparks live."
    },
    "seed": {
      "type": "integer",
      "default": 1,
      "doc": "Another number gives other sparks."
    }
  },
  "apply": [
    {
      "layer": {
        "place": "top",
        "layer": {
          "id": "burst",
          "kind": "particles",
          "in": "=at",
          "out": "=min(end, at + $length * beat)",
          "blend": "add",
          "sprite": "spark",
          "emitter": { "position": "$position" },
          "bursts": [ { "t": "=at", "count": "$count" } ],
          "life": "=$length * beat",
          "life_random": 0.4,
          "speed": "$speed",
          "speed_random": 0.6,
          "spread": 360,
          "drag": 2.5,
          "gravity": 0.4,
          "size": 0.8,
          "streak": 0.06,
          "color": "$color",
          "color_end": [1, 0.3, 0.1],
          "fade_out": 0.5,
          "seed": "$seed"
        }
      }
    }
  ]
}
