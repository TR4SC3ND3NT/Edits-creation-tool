{
  "format": "edits.preset/1",
  "name": "threshold_hit",
  "description": "Two-tone ink look on the hit: everything becomes pure black and white for a moment.",
  "tags": [
    "hit",
    "manga",
    "colour",
    "accent"
  ],
  "variables": {
    "level": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "doc": "Luminance cut: above is white, below black."
    },
    "length": {
      "type": "number",
      "default": 0.5,
      "min": 0.05,
      "max": 16,
      "unit": "beats",
      "doc": "How long it holds."
    }
  },
  "apply": [
    {
      "pulse": {
        "effect": "threshold",
        "param": "amount",
        "base": 0,
        "params": {
          "level": "$level"
        },
        "keys": [
          {
            "dt": 0,
            "v": 1,
            "ease": "hold"
          },
          {
            "dt": "=$length * beat",
            "v": "=orig"
          }
        ]
      }
    }
  ]
}
